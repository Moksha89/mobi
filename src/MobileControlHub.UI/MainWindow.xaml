<Window x:Class="MobileControlHub.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MobileControlHub.UI.Views"
        xmlns:vm="clr-namespace:MobileControlHub.UI.ViewModels"
        Title="Mobile Control Hub"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBgBrush}">

    <!-- DataTemplate mappings: ViewModel -> View -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
            <views:DevicesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionsViewModel}">
            <views:SessionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VpsSettingsViewModel}">
            <views:VpsSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== Left Sidebar ==================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App Title -->
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,24">
                    <TextBlock Text="Mobile Control Hub"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Device Management Console"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="24,0,0,8"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="Dashboard"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Dashboard"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="Devices"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Devices"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="Sessions"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Sessions"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="VPS / Remote"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="VPS"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="Logs"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Logs"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="Settings"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings"/>
                </StackPanel>

                <!-- Bottom status area -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16" VerticalAlignment="Bottom">
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="v1.0.0 MVP" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== Main Content ==================== -->
        <DockPanel Grid.Column="1">
            <!-- Top header bar -->
            <Border DockPanel.Dock="Top" Background="{StaticResource SecondaryBgBrush}"
                    Padding="24,12" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding CurrentPageTitle}"
                           Style="{StaticResource HeadingStyle}" Margin="0"/>
            </Border>

            <!-- Page content area -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,16">
                <ContentControl Content="{Binding CurrentPage}"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
